		<update id="removeroom" parameterType="int">
		    <![CDATA[
		        UPDATE room 
		        SET room_status = '삭제됨' 
		        WHERE room_id = #{room_id} AND room_status != '예약완료'
		    ]]>
		</update>	

		<select id="selectOverlappedGoodsName" resultType="int" parameterType="String">
	        <![CDATA[
	            SELECT count(*)
	            FROM goods
	            WHERE goods_name = #{goods_name}
	        ]]>
	    </select>
		
		<update id="updateGoodsStatus" parameterType="java.util.Map">
			<![CDATA[
			    UPDATE goods
			    SET goods_status = #{goods_status}
			    WHERE goods_num = #{goods_num}
			      AND seller_id = #{seller_id}
			]]>
		</update>
			
		<update id="updateRoomStatus" parameterType="map">
		    UPDATE room
		    SET room_status = #{status}
		    WHERE room_id = #{roomId}
		</update>

		<update id="restoreroom" parameterType="int">
		    <![CDATA[
		        UPDATE room 
		        SET room_status = '예약가능' 
