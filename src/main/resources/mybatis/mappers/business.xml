		<select id="selectNewOrderCount" resultType="int" parameterType="java.util.Map">
	        <![CDATA[
	            SELECT
	                COUNT(DISTINCT o.order_id)
	            FROM
	                userorder o INNER JOIN goods g
	                ON o.goods_num = g.goods_num
	            WHERE
	                g.seller_id = #{seller_id}
	        ]]>
	        <if test="beginDate != null and beginDate != '' and endDate != null and endDate != ''">
	            AND DATE(o.order_time) BETWEEN STR_TO_DATE(#{beginDate}, '%Y-%m-%d') AND STR_TO_DATE(#{endDate}, '%Y-%m-%d')
	        </if>
	    </select>
	
	    <select id="selectNewOrderList" resultMap="adminorderResult" parameterType="java.util.Map">
		    <![CDATA[
		        SELECT o.*
		        FROM userorder o INNER JOIN goods g
		        ON o.goods_num = g.goods_num
		        WHERE g.seller_id = #{seller_id}
		    ]]>
	        <if test="beginDate != null and beginDate != '' and endDate != null and endDate != ''">
		        AND DATE_FORMAT(o.order_time, '%Y-%m-%d') BETWEEN #{beginDate} AND #{endDate}
	        </if>
	        <![CDATA[
		        ORDER BY o.order_time DESC
		        LIMIT #{offset}, #{limit}
		    ]]>
		</select>
	    
