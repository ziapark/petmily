			        room_name=#{room_name},
			      </if>
			      <if test="room_type != '' and room_type != null">
			         room_type=#{room_type},
			      </if>
			      <if test="price != '' and price != null">
			         price=#{price},
			      </if>
			      <if test="max_capacity != '' and max_capacity != null">
			         max_capacity=#{max_capacity},
			      </if>
			      <if test="bed_type != '' and bed_type != null">
