		    ]]>
		</update>
		
		<select id="selectAllBusinesses" resultMap="businessResult">
		    <![CDATA[
		        SELECT business_id, business_name, seller_id
		        FROM business
		        WHERE approval_status = 'approve' AND del_yn = 'n'
		        ORDER BY business_name ASC
		    ]]>
		</select>
		
		<select id="selectAllPensionsWithBusinessInfo" resultMap="adminPensionResult">
		    <![CDATA[
		        SELECT
		            p.p_num, p.business_id, p.p_name, p.tel1, p.tel2, p.tel3, p.reg_date, p.pension_status,
		            b.business_name, b.seller_id, b.owner_name, b.business_number, b.roadAddress
		        FROM
		            pension p
		        JOIN
		            business b ON p.business_id = b.business_id
		        ORDER BY
		            p.p_num DESC
		    ]]>
		</select>

		<update id="updatePensionStatus" parameterType="map">
		    UPDATE pension
		    SET pension_status = #{pension_status}
		    WHERE p_num = #{p_num}
		</update>
		
		
	
		
